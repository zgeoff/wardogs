# Every value is an op:// reference that `op run --env-file=.env` resolves. Copy this file to .env
# as it is; nothing here is a secret. The items live in the zgeoff vault.

# Cloudflare zone access, and the R2 bucket that holds the Pulumi state
CLOUDFLARE_API_TOKEN=op://zgeoff/wardogs-infra/cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=op://zgeoff/wardogs-infra/cloudflare-account-id
AWS_ACCESS_KEY_ID=op://zgeoff/wardogs-infra/aws-access-key-id
AWS_SECRET_ACCESS_KEY=op://zgeoff/wardogs-infra/aws-secret-access-key
AWS_REGION=op://zgeoff/wardogs-infra/aws-region
R2_STATE_BUCKET=op://zgeoff/wardogs-infra/r2-state-bucket

# Encrypts the Pulumi stack secrets at rest
PULUMI_CONFIG_PASSPHRASE=op://zgeoff/wardogs-infra/pulumi-passphrase
