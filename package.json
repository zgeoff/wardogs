  "type": "module",
  "scripts": {
    "prepare": "lefthook install --force || true",
    "audit": "bun audit",
    "build": "turbo run build",
    "build:agents": "bash scripts/build-agents-md.sh agents/shared.md agents/project.md AGENTS.md",
    "codegen": "turbo run codegen typegen",
    "deadcode": "knip",
    "dev": "turbo run dev --filter=@wardogs-love/web",
    "e2e": "turbo run e2e",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "ladle": "turbo run ladle --filter=@wardogs-love/design-system",
    "lint": "turbo run codegen typegen && oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "lint:fix": "oxlint --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
